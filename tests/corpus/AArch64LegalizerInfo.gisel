ruleset A_G_SHUFFLE_VECTOR: G_SHUFFLE_VECTOR
    legal (not (slot(0) != slot(1)) and in(slot(0), [A_v8s8, A_v16s8, A_v4s16, A_v8s16, A_v2s32, A_v4s32, A_v2s64]))
    more(slot(1), replace(same_as(0))) when num_elems(slot(0)) > num_elems(slot(1))
    more(slot(0), pow2)
    more(slot(0), replace(same_as(1))) when num_elems(slot(0)) < num_elems(slot(1))
    widen(slot(0), 8)
    clamp_min(0, A_s8, num_elems(ty(A_v8s8)))
    clamp_max(0, A_s8, num_elems(ty(A_v16s8)))
    clamp_min(0, A_s16, num_elems(ty(A_v4s16)))
