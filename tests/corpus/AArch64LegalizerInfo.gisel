    clamp_min(0, A_s64, num_elems(ty(A_v2s64)))
    clamp_max(0, A_s64, num_elems(ty(A_v2s64)))
    scalarize(slot(0)) when bits_of(slot(0)) > 64
    bitcast(slot(0), replace(vec_of(num_elems(slot(0)), ty(A_i64)))) when sort_of(slot(0)) == pointer_vector

ruleset A_G_CONCAT_VECTORS: G_CONCAT_VECTORS
    legal in_pairs(slot(0), slot(1), [[A_v16s8, A_v8s8], [A_v8s16, A_v4s16], [A_v4s32, A_v2s32]])
    custom ((sort_of(slot(0)) == vector and not sort_of(slot(0)) == scalable_vector) and bits_of(slot(0)) < 8)
    bitcast(slot(0), replace(elt_size_to(div_lanes(slot(0), num_elems(slot(1))), size_of(slot(1))))) when ((sort_of(slot(0)) == vector and not sort_of(slot(0)) == scalable_vector) and (sort_of(slot(1)) == vector and not sort_of(slot(1)) == scalable_vector) and bits_of(slot(0)) >= 8 and is_pow2(bits_of(slot(0))) and size_of(slot(0)) <= 128 and size_of(slot(1)) <= 64)

