  [[maybe_unused]] const bool X_HasCMOV = Subtarget.canUseCMOV();
  [[maybe_unused]] const bool X_HasDQI = Subtarget.hasAVX512() && Subtarget.hasDQI();
  [[maybe_unused]] const bool X_HasLZCNT = Subtarget.hasLZCNT();
  [[maybe_unused]] const bool X_HasPOPCNT = Subtarget.hasPOPCNT();
  [[maybe_unused]] const bool X_HasSSE1 = Subtarget.hasSSE1();
  [[maybe_unused]] const bool X_HasSSE2 = Subtarget.hasSSE2();
  [[maybe_unused]] const bool X_HasSSE41 = Subtarget.hasSSE41();
  [[maybe_unused]] const bool X_HasVLX = Subtarget.hasVLX();
  [[maybe_unused]] const bool X_HasVPOPCNTDQ = Subtarget.hasVPOPCNTDQ();
  [[maybe_unused]] const bool X_Is64Bit = Subtarget.is64Bit();
  [[maybe_unused]] const bool X_UseX87 = !Subtarget.useSoftFloat() && Subtarget.hasX87();
  [[maybe_unused]] const LLT X_p0 = LLT::pointer(0, Subtarget.isTarget64BitLP64() ? 64 : 32);
  [[maybe_unused]] const LLT X_s1 = LLT::scalar(1);
  [[maybe_unused]] const LLT X_s8 = LLT::scalar(8);
  [[maybe_unused]] const LLT X_s16 = LLT::scalar(16);
  [[maybe_unused]] const LLT X_s32 = LLT::scalar(32);
  [[maybe_unused]] const LLT X_s64 = LLT::scalar(64);
  [[maybe_unused]] const LLT X_s80 = LLT::scalar(80);
  [[maybe_unused]] const LLT X_s128 = LLT::scalar(128);
  [[maybe_unused]] const LLT X_v2s32 = LLT::fixed_vector(2, 32);
  [[maybe_unused]] const LLT X_v4s8 = LLT::fixed_vector(4, 8);
  [[maybe_unused]] const LLT X_v16s8 = LLT::fixed_vector(16, 8);
  [[maybe_unused]] const LLT X_v8s16 = LLT::fixed_vector(8, 16);
  [[maybe_unused]] const LLT X_v4s32 = LLT::fixed_vector(4, 32);
  [[maybe_unused]] const LLT X_v2s64 = LLT::fixed_vector(2, 64);
  [[maybe_unused]] const LLT X_v2p0 = LLT::fixed_vector(2, X_p0);
  [[maybe_unused]] const LLT X_v32s8 = LLT::fixed_vector(32, 8);
  [[maybe_unused]] const LLT X_v16s16 = LLT::fixed_vector(16, 16);
  [[maybe_unused]] const LLT X_v8s32 = LLT::fixed_vector(8, 32);
  [[maybe_unused]] const LLT X_v4s64 = LLT::fixed_vector(4, 64);
  [[maybe_unused]] const LLT X_v4p0 = LLT::fixed_vector(4, X_p0);
  [[maybe_unused]] const LLT X_v64s8 = LLT::fixed_vector(64, 8);
  [[maybe_unused]] const LLT X_v32s16 = LLT::fixed_vector(32, 16);
  [[maybe_unused]] const LLT X_v16s32 = LLT::fixed_vector(16, 32);
  [[maybe_unused]] const LLT X_v8s64 = LLT::fixed_vector(8, 64);
  [[maybe_unused]] const LLT X_sMaxScalar = (X_Is64Bit ? X_s64 : X_s32);
  [[maybe_unused]] const LLT X_s8MaxVectorNoAVX512 = (X_HasAVX ? X_v32s8 : X_v16s8);
  [[maybe_unused]] const LLT X_s8MaxVector = (X_HasAVX512 ? X_v64s8 : X_s8MaxVectorNoAVX512);
  [[maybe_unused]] const LLT X_s16MaxVectorNoAVX512 = (X_HasAVX ? X_v16s16 : X_v8s16);
  [[maybe_unused]] const LLT X_s16MaxVector = (X_HasAVX512 ? X_v32s16 : X_s16MaxVectorNoAVX512);
  [[maybe_unused]] const LLT X_s32MaxVectorNoAVX512 = (X_HasAVX ? X_v8s32 : X_v4s32);
  [[maybe_unused]] const LLT X_s32MaxVector = (X_HasAVX512 ? X_v16s32 : X_s32MaxVectorNoAVX512);
  [[maybe_unused]] const LLT X_s64MaxVectorNoAVX512 = (X_HasAVX ? X_v4s64 : X_v2s64);
  [[maybe_unused]] const LLT X_s64MaxVector = (X_HasAVX512 ? X_v8s64 : X_s64MaxVectorNoAVX512);
  [[maybe_unused]] const LLT X_sse2MaxScalar = (X_HasSSE2 ? X_s64 : X_s32);
  [[maybe_unused]] const LLT X_x87MinScalar = (X_UseX87 && !(X_HasSSE1) ? X_s16 : X_s32);
  [[maybe_unused]] const LLT X_cmovMinScalar = (X_HasCMOV ? X_s16 : X_s8);

  if ((Q.Types[0] == X_p0 || Q.Types[0] == X_s1 || Q.Types[0] == X_s8 || Q.Types[0] == X_s16 || Q.Types[0] == X_s32 || Q.Types[0] == X_s64)) {
    return {LegalizeActions::Legal, 0, LLT{}};
