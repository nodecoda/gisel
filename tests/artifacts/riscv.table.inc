  [[maybe_unused]] const LLT R_sel0 = (R_XLen_64 || R_ST_hasStdExtD ? R_s64 : R_s32);

  return {LegalizeActions::Legal, 0, LLT{}};
  return {LegalizeActions::Unsupported, 0, LLT{}};
}

